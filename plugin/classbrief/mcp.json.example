{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "classbrief": {
      "type": "streamable-http",
      "url": "https://DEINE-VERIFIZIERTE-CLASSBRIEF-DOMAIN/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["classbrief"],
            "defaultScopes": ["classbrief"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
